[Unit]
Description=Pronos: Corbel, the autonomous agent (one step every 5 minutes)
After=network-online.target
[Service]
Type=simple
WorkingDirectory=/opt/pronos
ExecStart=/usr/bin/python3 /opt/pronos/run.py agent 300
Nice=19
CPUWeight=20
MemoryMax=768M
Restart=always
RestartSec=60
[Install]
WantedBy=multi-user.target
